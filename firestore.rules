rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isProjectMember(projectId) {
      return isSignedIn() &&
        projectId != null &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds;
    }

    // Usernames: exact lookup allowed for @username login & availability check; listing disallowed
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // User profiles: readable by any signed-in user for search & display
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Privacy-safe Free/Busy slots (no event titles or descriptions)
    match /availability/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid);
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.requesterId
        && request.auth.uid in request.resource.data.users;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }

    // Friend Groups (independent of projects)
    match /friendGroups/{groupId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in resource.data.pendingMemberIds
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in resource.data.pendingMemberIds
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;
    }

    // Projects
    match /projects/{projectId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        exists(/databases/$(database)/documents/projectInvites/$(('pinv_' + projectId + '_' + request.auth.uid)))
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Project Invites
    match /projectInvites/{inviteId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.inviterId;
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.inviterId ||
        request.auth.uid == resource.data.inviteeId
      );
    }

    // Event Requests (Terminanfragen)
    match /eventRequests/{requestId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid in resource.data.inviteeIds
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.creatorId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid in resource.data.inviteeIds
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.creatorId;
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds ||
        request.auth.uid in request.resource.data.participantIds
      );

      match /messages/{msgId} {
        allow read, create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // Ideas (personal or project-scoped)
    match /ideas/{ideaId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isProjectMember(resource.data.projectId)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isProjectMember(resource.data.projectId)
      );
    }

    // Tasks (personal or project-scoped)
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isProjectMember(resource.data.projectId)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isProjectMember(resource.data.projectId)
      );
    }

    // Calendar Events (personal, shared participants, or project-scoped)
    match /events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        isProjectMember(resource.data.projectId)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds) ||
        isProjectMember(resource.data.projectId) ||
        (resource.data.eventRequestId != null &&
         request.auth.uid in get(/databases/$(database)/documents/eventRequests/$(resource.data.eventRequestId)).data.inviteeIds)
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isProjectMember(resource.data.projectId)
      );
    }
  }
}
