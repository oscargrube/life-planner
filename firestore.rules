rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Hilfsfunktion: Prüft, ob die Anfrage von einem authentifizierten Nutzer stammt
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sammlung: Ideen
    match /ideas/{ideaId} {
      allow read, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Sammlung: Aufgaben
    match /tasks/{taskId} {
      allow read, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Sammlung: Kalender-Termine
    match /events/{eventId} {
      allow read, delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
